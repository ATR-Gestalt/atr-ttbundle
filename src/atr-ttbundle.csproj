<Project Sdk="Microsoft.NET.Sdk">
	<!-- Assembly Identity -->
	<PropertyGroup>
		<!--
			This is used by update checker, and therefore must be
			the same as git tag name but with no "v" prefix
		-->
		<Version>0.1.0</Version>
		<RootNamespace>StlTechRelGen</RootNamespace>
		<!-- 产物名：文件名全小写（跨平台安全），展示名用 ATR-TTbundle -->
		<AssemblyName>atr-ttbundle</AssemblyName>
		<AssemblyTitle>ATR Tech Tree Bundle</AssemblyTitle>
		<Product>$(AssemblyTitle)</Product>
		<Description>为 Stellaris 科技生成「标签 + 科技树」本地化，合并 TechnologyTree 与 Tech Relations 两种表现</Description>
		<!-- 上游作者，按 MIT 要求保留署名 -->
		<Company>Clazex (upstream) / ATR (fork)</Company>
		<Copyright>Copyright (c) 2026 Clazex; fork modifications by ATR</Copyright>
	</PropertyGroup>

	<!-- Language & Analysis -->
	<PropertyGroup>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AnalysisMode>Recommended</AnalysisMode>
		<NoWarn>$(NoWarn);CA1716</NoWarn> <!-- Suppression: mod is reserved keyword -->
	</PropertyGroup>

	<!-- Build -->
	<PropertyGroup>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
		<DebugType>portable</DebugType>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
	</PropertyGroup>

	<!-- Publish -->
	<PropertyGroup>
		<!--
			ATRTree 的目标是「玩家拿到就能双击就跑，不用装 .NET 运行时」，
			所以保持 self-contained（自带运行时）。

			不分单文件：单文件模式下运行时要把内嵌的原生库解压到
			%TEMP%\.net\<应用名>\<哈希>\，实测在部分 Windows 环境下解压会被拒
			（Error code: 5，Access Denied），程序连启动都过不了，
			用户看到的就是「双击没反应」。分目录输出后不依赖运行时解压。

			打包结构由 scripts/build.ps1 整理：程序本体（200+ 文件）收进
			app/ 子目录，外层只留启动器与文档，并将整个目录压成同名 zip。
		-->
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<!-- 单文件关闭后，原生库与托管库都随目录平铺输出，无需自解压 -->
		<IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration) == 'Release'">
		<PathMap>$(MSBuildProjectDirectory)=/</PathMap>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(CI)' == 'true'">
		<RestoreLockedMode>True</RestoreLockedMode>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!--
		CWTools 2.39.0：取自 vendor/cwtools-2.39.0（随仓库一起提供），
		找不到时回退到本机 VS Code 扩展目录。
		为什么不用 NuGet：NuGet 上最高只有 0.6.0-alpha，实测与 0.5.0-alpha 一样不认
		Stellaris 4.x 的 `key? =` 可选赋值语法，会整文件丢读 00_megastructures.txt 与
		00_forceofwill_tech.txt（12 个巨构科技 + 4 个 Force of Will 科技全缺）。
		2.39.0 实测可正确解析这两个文件，但它只在扩展里私有打包，未发布到 NuGet。
		许可：CWTools 及其配套程序集均为 MIT，声明见 vendor/cwtools-2.39.0/LICENSE.cwtools.txt。
	-->
	<PropertyGroup>
		<VendoredCwToolsDir>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), '..', 'vendor', 'cwtools-2.39.0'))</VendoredCwToolsDir>
		<ExtensionCwToolsDir>$([System.IO.Path]::Combine($(USERPROFILE), '.vscode', 'extensions', 'foreverskywalker.foreverskywalker-stellaris-cwtools-2.39.0', 'bin', 'server', 'win-x64'))</ExtensionCwToolsDir>
		<!-- 优先级：显式传入的 CwToolsDir > vendor 目录 > 本机扩展目录 -->
		<CwToolsDir Condition="'$(CwToolsDir)' == '' and Exists('$(VendoredCwToolsDir)\CWTools.dll')">$(VendoredCwToolsDir)</CwToolsDir>
		<CwToolsDir Condition="'$(CwToolsDir)' == ''">$(ExtensionCwToolsDir)</CwToolsDir>
	</PropertyGroup>

	<!-- vendor 目录自带许可声明，分发时随二进制一起带 -->
	<ItemGroup Condition="'$(CwToolsDir)' == '$(VendoredCwToolsDir)'">
		<None Include="$(VendoredCwToolsDir)\LICENSE.cwtools.txt" Link="LICENSE.cwtools.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="CWTools">
			<HintPath>$(CwToolsDir)\CWTools.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="Shared">
			<HintPath>$(CwToolsDir)\Shared.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="CSharpHelpers">
			<HintPath>$(CwToolsDir)\CSharpHelpers.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="FParsec">
			<HintPath>$(CwToolsDir)\FParsec.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="FParsecCS">
			<HintPath>$(CwToolsDir)\FParsecCS.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="FSharp.Core">
			<HintPath>$(CwToolsDir)\FSharp.Core.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="FSharp.Data">
			<HintPath>$(CwToolsDir)\FSharp.Data.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="FSharp.Collections.ParallelSeq">
			<HintPath>$(CwToolsDir)\FSharp.Collections.ParallelSeq.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="FSharpx.Collections">
			<HintPath>$(CwToolsDir)\FSharpx.Collections.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="Sandwych.QuickGraph.Core">
			<HintPath>$(CwToolsDir)\Sandwych.QuickGraph.Core.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="DotNet.Glob">
			<HintPath>$(CwToolsDir)\DotNet.Glob.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="VDS.Common">
			<HintPath>$(CwToolsDir)\VDS.Common.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="FsPickler">
			<HintPath>$(CwToolsDir)\FsPickler.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="ICSharpCode.SharpZipLib">
			<HintPath>$(CwToolsDir)\ICSharpCode.SharpZipLib.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="KTrie">
			<HintPath>$(CwToolsDir)\KTrie.dll</HintPath>
			<Private>true</Private>
		</Reference>
		<Reference Include="ZString">
			<HintPath>$(CwToolsDir)\ZString.dll</HintPath>
			<Private>true</Private>
		</Reference>

		<PackageReference Include="Tomlyn" Version="2.10.1" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />


		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.5" />
		<!--
			Use newer shipped native SQLite builds instead of the vulnerable
			SQLitePCLRaw.lib.e_sqlite3 package (CVE-2025-6965) used by
			Microsoft.EntityFrameworkCore.Sqlite
		-->
		<PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />

		<PackageReference Include="Spectre.Console" Version="0.57.2" />
		<PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />

		<PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources/**" />
	</ItemGroup>

	<ItemGroup Condition="$(Configuration) == 'Debug'">
		<Content Condition="Exists('config.toml')" Include="config.toml">
			<TargetPath>$(AssemblyName).toml</TargetPath>
			<CopyToOutputDirectory>IfDifferent</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
